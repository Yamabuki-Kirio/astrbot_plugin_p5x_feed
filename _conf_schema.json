{
  "tieba_enabled": {
    "description": "启用贴吧",
    "type": "bool",
    "default": true
  },
  "heybox_enabled": {
    "description": "启用小黑盒（仅分区首屏）",
    "type": "bool",
    "default": true
  },
  "check_minutes": {
    "description": "检查间隔，分钟，最少10",
    "type": "int",
    "default": 30
  },
  "max_posts": {
    "description": "每次最多发送篇数，1–10",
    "type": "int",
    "default": 3
  },
  "tieba_forum": {
    "description": "贴吧名称，不带“吧”",
    "type": "string",
    "default": "女神异闻录夜幕魅影"
  },
  "tieba_days": {
    "description": "贴吧普通热门帖有效天数",
    "type": "int",
    "default": 7
  },
  "tieba_likes": {
    "description": "贴吧主题点赞门槛，含等于",
    "type": "int",
    "default": 50
  },
  "tieba_pages": {
    "description": "普通列表和精华列表各读取页数，1–10",
    "type": "int",
    "default": 3
  },
  "recheck_limit": {
    "description": "每轮离开列表的近期贴吧帖子复查上限，0–30",
    "type": "int",
    "default": 10
  },
  "heybox_topics": {
    "description": "小黑盒分区ID列表",
    "type": "list",
    "default": [
      "600205",
      "671144"
    ]
  },
  "heybox_days": {
    "description": "小黑盒热门帖有效天数",
    "type": "int",
    "default": 14
  },
  "heybox_likes": {
    "description": "小黑盒点赞门槛，含等于",
    "type": "int",
    "default": 100
  },
  "blocked_words": {
    "description": "标题和简介屏蔽词，匹配任一即跳过",
    "type": "list",
    "default": []
  },
  "send_mode": {
    "description": "消息样式：forward 为合并转发，text 为纯文本",
    "type": "string",
    "default": "forward",
    "options": [
      "forward",
      "text"
    ]
  },
  "include_title_author": {
    "description": "发送标题信息（来源、标题、作者、时间、互动数据）",
    "type": "bool",
    "default": true
  },
  "include_summary": {
    "description": "显示正文摘录，保留段落换行",
    "type": "bool",
    "default": true
  },
  "include_links": {
    "description": "显示原始链接",
    "type": "bool",
    "default": true
  },
  "include_images": {
    "description": "合并转发时附带可读取的帖子配图，失败则跳过图片",
    "type": "bool",
    "default": true
  },
  "max_images_per_post": {
    "description": "每篇最多配图数，1–3",
    "type": "int",
    "default": 1
  },
  "summary_length": {
    "description": "每篇正文摘录上限，50–2000 字符，超出显示省略号",
    "type": "int",
    "default": 500
  },
  "forward_layout": {
    "description": "转发节点布局：compact 每帖一个节点，sectioned 按信息、正文、图片、链接拆分",
    "type": "string",
    "default": "compact",
    "options": [
      "compact",
      "sectioned"
    ]
  },
  "include_overview": {
    "description": "发送概览节点（纯文本模式为概览段落）",
    "type": "bool",
    "default": true
  }
}
